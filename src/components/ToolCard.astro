---
import {t,href,type Locale} from '../i18n';
const {locale}=Astro.props as {locale:Locale}; const d=t(locale);
---
<div class="tools-directory-grid">
  <article class="tool-directory-card"><div class="tool-directory-art" aria-hidden="true"><svg viewBox="0 0 420 160" focusable="false" fill="none"><rect x="146" y="16" width="128" height="128" rx="22"/><path d="M176 52h68M176 72h68M176 92h42M176 112h28"/><path d="m252 93 13 13 27-31"/></svg></div><div class="tool-directory-body"><p class="eyebrow">CSV · {d.cover.inBrowser}</p><h2>Order Rescue</h2><p>{d.home.toolDesc}</p><a class="button" href={href(locale,'tools/order-rescue')}>{d.home.toolAction}<span aria-hidden="true">↗</span></a></div></article>
  <article class="tool-directory-card"><div class="tool-directory-art pricing-art" aria-hidden="true"><svg viewBox="0 0 420 160" focusable="false" fill="none"><rect x="135" y="18" width="150" height="124" rx="20"/><path d="M161 54h98M161 76h46M161 103h38"/><circle cx="238" cy="100" r="25"/><path d="M238 84v32m-12-22h17a7 7 0 010 14h-17"/></svg></div><div class="tool-directory-body"><p class="eyebrow">{d.profitCalculator.eyebrow}</p><h2>{d.profitCalculator.title}</h2><p>{d.profitCalculator.description}</p><a class="button" href={href(locale,'tools/profit-calculator')}>{d.profitCalculator.open}<span aria-hidden="true">↗</span></a></div></article>
  <article class="tool-directory-card"><div class="tool-directory-art image-art" aria-hidden="true"><svg viewBox="0 0 420 160" focusable="false" fill="none"><rect x="139" y="18" width="142" height="124" rx="20"/><rect x="160" y="40" width="100" height="78" rx="8"/><circle cx="189" cy="64" r="8"/><path d="m164 108 29-27 15 14 15-18 34 31"/><path d="M112 46h20m-20 14h13m164-5h17m-17 14h25"/></svg></div><div class="tool-directory-body"><p class="eyebrow">JPEG · PNG · WebP</p><h2>{d.imageOptimizer.title}</h2><p>{d.imageOptimizer.description}</p><a class="button" href={href(locale,'tools/image-optimizer')}>{d.imageOptimizer.open}<span aria-hidden="true">↗</span></a></div></article>
</div>
