---
import {t,type Locale} from '../i18n';import {fields} from '../lib/types';
const {locale}=Astro.props as {locale:Locale};const d=t(locale);
---
<div id="order-rescue" class="tool-shell" data-locale={locale}>
<p class="notice">{d.tool.privacy}</p><noscript><p class="message error">{d.tool.noscript}</p></noscript>
<section class="panel" aria-labelledby="upload-title"><div class="tool-top"><div><h2 id="upload-title">{d.tool.uploadTitle}</h2><p class="notice">{d.tool.uploadText}</p></div><button class="button secondary small" id="clear-data" type="button">{d.tool.clear}</button></div><div class="upload-box"><label for="csv-file">{d.tool.file}</label><input id="csv-file" type="file" accept=".csv,text/csv"/></div><div class="actions"><button class="button secondary" id="load-sample" type="button">{d.tool.sample}</button><a class="text-link" href={'/samples/orders-'+locale+'.csv'} download>{d.tool.downloadSample}</a></div><p id="demo-note" class="notice mt-5" hidden>{d.tool.demo}</p></section>
<p id="tool-status" role="status" aria-live="polite" class="message" hidden></p><p id="tool-error" role="alert" class="message error" hidden></p>
<section id="mapping-panel" class="panel" hidden aria-labelledby="mapping-title"><h2 id="mapping-title" tabindex="-1">{d.tool.mapping}</h2><p class="notice">{d.tool.mappingHelp}</p><p id="import-count" class="notice"></p><form id="mapping-form"><div class="mapping-grid">{fields.map((field,i)=><div class="field"><label for={'map-'+field}>{d.tool.fields[field]}{i<3?' *':''}</label><select id={'map-'+field} name={field} required={i<3}><option value="">{d.tool.unmapped}</option></select></div>)}</div><div class="field date-field"><label for="reference-date">{d.tool.date}</label><input id="reference-date" type="date" required min="0001-01-01" max="9999-12-31" aria-describedby="date-help"/></div><p id="date-help" class="notice mt-3">{d.tool.dateHelp}</p><label class="check-label"><input type="checkbox" id="warn-missing" checked/><span>{d.tool.warn}</span></label><details><summary>{d.tool.statuses}</summary><p>{d.tool.statusHelp}</p></details><div class="actions"><button class="button" id="analyze-button" type="submit">{d.tool.analyze}</button></div></form></section>
<section id="report-panel" class="panel" hidden aria-labelledby="report-title"><div class="tool-top"><h2 id="report-title" tabindex="-1">{d.tool.results}</h2><button id="download-report" class="button secondary small" type="button">{d.tool.export}</button></div><div class="stats" id="report-stats"></div><p class="notice">{d.tool.priority}</p><p class="notice">{d.tool.counts}</p><div class="filters"><div class="field"><label for="category-filter">{d.tool.category}</label><select id="category-filter"><option value="">{d.tool.all}</option></select></div><div class="field"><label for="severity-filter">{d.tool.severity}</label><select id="severity-filter"><option value="">{d.tool.all}</option>{(['high','medium','info'] as const).map(s=><option value={s}>{d.severity[s]}</option>)}</select></div></div><p id="result-count" class="notice" role="status"></p><div id="results-table-wrap" class="table-scroll" tabindex="0" role="region" aria-label={d.tool.results}><table><thead><tr><th scope="col">{d.tool.order}</th><th scope="col">{d.tool.issue}</th><th scope="col">{d.tool.severity}</th><th scope="col">{d.tool.explanation}</th><th scope="col">{d.tool.action}</th></tr></thead><tbody id="result-rows"></tbody></table></div><p id="empty-state" class="empty" hidden></p><div id="pagination" class="pagination"><button class="button secondary small" id="previous-page" type="button">{d.tool.previous}</button><span id="page-number"></span><button class="button secondary small" id="next-page" type="button">{d.tool.next}</button></div></section></div>
<script>import '../scripts/order-rescue';</script>
