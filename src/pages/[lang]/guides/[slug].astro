---
import {getCollection,render,type CollectionEntry} from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ArticleHeader from '../../../components/ArticleHeader.astro';
import ArticleTOC from '../../../components/ArticleTOC.astro';
import ArticleFigure from '../../../components/ArticleFigure.astro';
import ArticleSources from '../../../components/ArticleSources.astro';
import ArticleChecklist from '../../../components/ArticleChecklist.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import AdSlot from '../../../components/AdSlot.astro';
import {t,href,type Locale} from '../../../i18n';

export async function getStaticPaths(){
  const guides=await getCollection('guides',({data})=>data.published);
  return guides.map(guide=>({
    params:{lang:guide.data.locale,slug:guide.data.slug},
    props:{guide,equivalents:Object.fromEntries(guides.filter(g=>g.data.translationKey===guide.data.translationKey).map(g=>[g.data.locale,href(g.data.locale,'guides/'+g.data.slug)]))}
  }));
}

interface Props {guide:CollectionEntry<'guides'>;equivalents:Partial<Record<Locale,string>>}
const {guide,equivalents}=Astro.props;
const g=guide.data;
const locale=g.locale;
const d=t(locale);
const e=d.editorial;
const {Content,headings}=await render(guide);
const related=await getCollection('guides',({data})=>data.published&&data.locale===locale&&g.relatedArticles.includes(data.translationKey)&&data.translationKey!==g.translationKey);
---
<Layout locale={locale} title={g.seo.title??g.title} description={g.seo.description??g.description} slug={'guides/'+g.slug} equivalents={equivalents} article={true} publishedAt={g.publishedAt!} updatedAt={g.updatedAt!}>
  <ArticleHeader
    title={g.title}
    description={g.description}
    category={e.categories[g.category]}
    categoryHref={href(locale,'topics/'+g.category)}
    publishedAt={g.publishedAt!}
    updatedAt={g.updatedAt!}
    tags={g.tags}
    publishedLabel={e.published}
    updatedLabel={e.updated}
    backLabel={d.support.backGuides}
    backHref={href(locale,'guides')}
    tagsLabel={e.tags}
  />
  <div class="article-layout wrap">
    <ArticleTOC headings={headings} label={e.toc}/>
    <article class="article">
      <ArticleFigure image={g.image}/>
      <div class="article-body"><Content/></div>
      <ArticleChecklist items={g.checklist??[]} title={e.checklist}/>
      <AdSlot placement="article-after-content"/>
      <ArticleSources title={e.sources} checkedLabel={e.checked} checkedAt={g.sourcesCheckedAt??''} sources={g.sources}/>
      <RelatedArticles guides={related} title={e.relatedArticles}/>
      {g.relatedTools.includes('order-rescue')&&<aside class="related-tool panel">
        <p class="eyebrow">{e.relatedTools}</p>
        <p>{d.support.relatedText}</p>
        <a class="button" href={href(locale,'tools/order-rescue')}>Order Rescue ↗</a>
      </aside>}
      {g.relatedTools.includes('profit-calculator')&&<aside class="related-tool panel"><p class="eyebrow">{e.relatedTools}</p><p>{d.profitCalculator.description}</p><a class="button" href={href(locale,'tools/profit-calculator')}>{d.profitCalculator.open} ↗</a></aside>}
    </article>
  </div>
</Layout>
