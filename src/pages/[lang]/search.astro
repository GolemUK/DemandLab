---
import {getCollection} from 'astro:content';import Layout from '../../layouts/Layout.astro';import SearchForm from '../../components/SearchForm.astro';import GuideIllustration from '../../components/GuideIllustration.astro';import {t,href,locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const locale=Astro.params.lang as Locale;const d=t(locale);const e=d.editorial;const guides=await getCollection('guides',({data})=>data.published&&data.locale===locale);const items=[...guides.map(({data:g})=>({title:g.title,description:g.description,url:href(locale,'guides/'+g.slug),kind:e.guideType,category:g.category,search:[g.title,g.description,e.categories[g.category],...g.tags].join(' ')})),{title:'Order Rescue',description:d.home.toolDesc,url:href(locale,'tools/order-rescue'),kind:e.toolsType,category:'business',search:['Order Rescue',d.home.toolDesc,e.categories.business,'CSV',locale==='uk'?'замовлення оплата термін':'orders payment deadline'].join(' ')}];
---
<Layout locale={locale} title={e.searchPage} description={e.searchDescription} slug="search"><div class="wrap"><header class="page-heading"><h1>{e.searchPage}</h1><p>{e.searchDescription}</p></header><SearchForm locale={locale}/><noscript><p>{e.searchNoJS}</p></noscript><p id="search-count" role="status" aria-live="polite" data-label={e.searchResults}>{e.searchResults}: {items.length}</p><p id="search-empty" hidden>{e.searchNone} <a href={href(locale,'guides')}>{e.all} →</a></p><div class="editorial-grid" id="search-results">{items.map(item=><a class="guide-card" href={item.url} data-search={item.search}><GuideIllustration category={item.category}/><div class="guide-card-body"><p class="guide-badge">{item.kind}</p><h2>{item.title}</h2><p class="guide-card-description">{item.description}</p><span class="guide-card-link">{e.read}<span aria-hidden="true">↗</span></span></div></a>)}</div></div></Layout>
<script>import '../../scripts/search';</script>
