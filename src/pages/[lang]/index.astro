---
import Layout from '../../layouts/Layout.astro';
import HomeCover from '../../components/HomeCover.astro';
import {t,locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const locale=Astro.params.lang as Locale;const d=t(locale);
---
<Layout locale={locale} title={d.home.title} description={d.editorial.description}><HomeCover locale={locale}/></Layout>
