---
import AdSlot from '../../components/AdSlot.astro';
import {getCollection} from 'astro:content';import Layout from '../../layouts/Layout.astro';import ToolCard from '../../components/ToolCard.astro';import ArticleCard from '../../components/ArticleCard.astro';import SearchForm from '../../components/SearchForm.astro';import {categoryIds} from '../../lib/editorial';import {t,href,locales,type Locale} from '../../i18n';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const locale=Astro.params.lang as Locale;const d=t(locale);const e=d.editorial;const guides=await getCollection('guides',({data})=>data.published&&data.locale===locale);const featured=guides.find(g=>g.data.translationKey==='google-storage-full')??guides[0];const latest=guides.filter(g=>g.id!==featured?.id).sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt));
---
<Layout locale={locale} title={d.home.title} description={d.home.description}><div class="wrap"><section class="editorial-intro"><p class="eyebrow">{e.eyebrow}</p><h1>{e.headline}</h1><p>{e.description}</p></section>{featured&&<section class="feature-story"><div><p class="eyebrow">{e.featured} · {e.categories[featured.data.category]}</p><h2><a href={href(locale,'guides/'+featured.data.slug)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="button" href={href(locale,'guides/'+featured.data.slug)}>{e.read} ↗</a></div>{featured.data.image&&<img src={featured.data.image.src} alt={featured.data.image.alt} width="960" height="300"/>}</section>}<section class="section search-section"><h2>{e.searchTitle}</h2><SearchForm locale={locale}/></section>{latest.length>0&&<section class="section"><div class="section-heading"><h2>{e.latest}</h2><a class="text-link" href={href(locale,'guides')}>{e.all} →</a></div><div class="editorial-grid">{latest.map(guide=><ArticleCard guide={guide}/>)}</div></section>}<AdSlot placement="home-after-articles"/><section class="section" id="problems"><h2>{e.topics}</h2><ul class="topic-list">{categoryIds.map(category=><li>{guides.some(g=>g.data.category===category)?<a href={href(locale,'topics/'+category)}>{e.categories[category]} ↗</a>:<span>{e.categories[category]} <small>{e.planned}</small></span>}</li>)}</ul><p class="category-note">{e.plannedNote}</p></section><section class="section"><h2>{e.tools}</h2><ToolCard locale={locale}/></section><section class="section business-note"><p class="eyebrow">{e.business}</p><h2>{e.businessLink}</h2><p>{e.businessText}</p><a class="text-link" href={href(locale,'solutions')}>{e.businessLink} →</a></section></div></Layout>
